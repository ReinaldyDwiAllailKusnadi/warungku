# KENAPA .env TIDAK IKUT MASUK GIT:
#   Berkas ini memuat tiga rahasia. Yang masuk repo hanya contoh bentuknya.
#   Isi berkas aslinya: izin 600, diisi nilai acak, tidak pernah dikirim
#   ke mana pun lewat chat.
#
#   DATABASE_URL   — alamat PostgreSQL, memuat kata sandi database.
#   SESSION_SECRET — kunci penandatanganan cookie sesi petugas. Kalau
#                    bocor, siapa pun bisa memalsukan sesi masuk.
#   WEBHOOK_SECRET — kunci HMAC pemberitahuan pembayaran. Kalau bocor,
#                    siapa pun bisa mengirim pemberitahuan palsu dan
#                    menandai pesanan lunas tanpa uang masuk. Inilah
#                    satu-satunya yang membuktikan keaslian webhook.
#
# Buat nilai acak: openssl rand -hex 32

# PostgreSQL
DATABASE_URL="postgresql://warung:SANDI_DATABASE_ANDA@127.0.0.1:5432/warung"

# Kunci sesi petugas (acak, 32 byte heksadesimal)
SESSION_SECRET="GANTI_DENGAN_NILAI_ACAK"

# Kunci tanda tangan webhook pembayaran (acak, 32 byte heksadesimal)
WEBHOOK_SECRET="GANTI_DENGAN_NILAI_ACAK"
